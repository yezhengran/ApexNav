# All four installed vision models run locally for the current reproduction.
# Copy to config/vlm.env; replace individual URLs only for a remote deployment.
# Full URLs take priority over APEXNAV_VLM_HOST and legacy port arguments.
APEXNAV_GDINO_URL=http://127.0.0.1:12181/gdino
APEXNAV_BLIP2_URL=http://127.0.0.1:12182/blip2itm
APEXNAV_SAM_URL=http://127.0.0.1:12183/mobile_sam
APEXNAV_YOLO_URL=http://127.0.0.1:12184/yolov7
APEXNAV_VLM_TIMEOUT=120
# Return only unused CUDA cache after requests so four processes can share 8 GB.
# Set to 0 on a larger GPU to prefer allocator reuse/latency.
APEXNAV_VLM_RELEASE_IDLE_CACHE=1

# Optional bearer token for a protected API gateway or ApexNav server.
# APEXNAV_VLM_API_KEY=replace-with-your-token

# SSH forwarding alternative: keep the model servers bound to loopback and use
# http://127.0.0.1:12181/gdino etc. after establishing all four SSH tunnels.
